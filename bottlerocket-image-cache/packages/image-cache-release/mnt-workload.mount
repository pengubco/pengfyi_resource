[Unit]
Description=Workload volume (/mnt/workload)
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target
Before=local-fs.target
Requires=format-workload-volume.service
After=format-workload-volume.service
RequiresMountsFor=/mnt

[Mount]
What=LABEL=WORKLOAD
Where=/mnt/workload
Type=ext4
Options=defaults

[Install]
WantedBy=local-fs.target
