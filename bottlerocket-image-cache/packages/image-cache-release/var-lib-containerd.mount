[Unit]
Description=containerd root on the workload volume (/var/lib/containerd)
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target
Before=local-fs.target
# prepare-var-lib-containerd.service (core kit) creates the mount point.
Wants=prepare-var-lib-containerd.service prepare-workload-volume.service
After=prepare-var-lib-containerd.service prepare-workload-volume.service
RequiresMountsFor=/mnt/workload /var

[Mount]
What=/mnt/workload/containerd
Where=/var/lib/containerd
Type=none
Options=rbind,defaults

[Install]
WantedBy=local-fs.target
