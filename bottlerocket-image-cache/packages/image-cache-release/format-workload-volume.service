[Unit]
Description=Format the workload volume (/dev/xvdc)
DefaultDependencies=no
Before=local-fs.target
Requires=dev-disk-by\x2debs\x2did-xvdc.device check-workload-volume.service
After=dev-disk-by\x2debs\x2did-xvdc.device check-workload-volume.service
RefuseManualStart=true
RefuseManualStop=true
ConditionPathExists=!/run/workload-volume-has-filesystem

[Service]
Type=oneshot
RemainAfterExit=true
StandardError=journal+console
ExecStart=/sbin/mkfs -t ext4 -L WORKLOAD /dev/disk/by-ebs-id/xvdc

[Install]
WantedBy=local-fs.target
